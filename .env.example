DATABASE_URL=postgresql://lumina:lumina@127.0.0.1:5433/lumina
PORT=8080
APP_TIMEZONE=Asia/Qyzylorda
JWT_SECRET=change-me-to-a-long-random-string
ACCESS_TTL_MIN=120
REFRESH_TTL_DAYS=30
MIGRATIONS_DIR=db/migrations
SEEDS_DIR=seeds
PUBLIC_DIR=frontend/dist
LOG_LEVEL=info
RATE_LIMIT_PER_MIN=600
CORS_ORIGIN=*
# Keep 1 for local demo accounts. Render sets this to 0 and asks for a private admin login.
DEMO_MODE=1
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
# Optional Claude integration
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_MODEL=claude-sonnet-4-20250514
# Optional Redis cache (SQL fallback is used when absent)
# REDIS_URL=redis://127.0.0.1:6379
